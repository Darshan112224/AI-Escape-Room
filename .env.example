# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# The real .env file is listed in .gitignore and must never be committed.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use.
# "gemini-flash-latest" is an alias that always points to the current Flash model.
# You can pin a specific one instead, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest
