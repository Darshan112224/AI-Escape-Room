# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# The real .env file is listed in .gitignore and must never be committed.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use.
# Google retires model names over time. If you get "model not found",
# run `python v1/list_models.py` to see the models your key can use.
GEMINI_MODEL=gemini-3.5-flash
